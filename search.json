---
layout: null
---
[
  {% assign searchable_posts = site.posts | where_exp: "post", "post.redirect_to == nil" %}
  {% for post in searchable_posts %}
    {
      "title"    : "{{ post.title | escape }}",
      "category" : "{{ post.category }}",
      "tags"     : "{{ post.tags | join: ', ' }}",
      "url"      : "{{ site.baseurl }}{{ post.url }}",
      "date"     : "{{ post.date }}"
    } {% unless forloop.last %}, {% endunless %}
  {% endfor %}
]
