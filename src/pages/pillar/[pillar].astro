---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { PILLARS } from '../../consts';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const pillars = Object.keys(PILLARS);
  return pillars.map((pillar) => ({
    params: { pillar },
  }));
}

const { pillar } = Astro.params;
const info = PILLARS[pillar as string] || PILLARS.engineering;

const allPosts = await getCollection('blog');
const pillarPosts = allPosts
  .filter((p) => p.data.pillar === pillar)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const otherPillars = Object.values(PILLARS).filter((p) => p.id !== pillar);
---

<BaseLayout
  title={`${info.name} · 专区`}
  description={info.description}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <!-- Pillar Banner -->
    <div
      class="p-8 sm:p-10 rounded-3xl border mb-12 relative overflow-hidden bg-gradient-to-br from-[#111827] to-[#162035]"
      style={{ borderColor: `${info.color}40` }}
    >
      <div
        class="absolute -right-10 -bottom-10 w-64 h-64 rounded-full blur-3xl opacity-20 pointer-events-none"
        style={{ backgroundColor: info.color }}
      ></div>

      <div class="relative z-10 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono mb-4 border" style={{ color: info.color, backgroundColor: info.badgeBg, borderColor: `${info.color}50` }}>
          <span>{info.icon}</span>
          <span>思想支柱专区</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-100 tracking-tight mb-4">
          {info.name}
        </h1>

        <p class="text-base text-slate-300 leading-relaxed mb-6">
          {info.description}
        </p>

        <div class="flex items-center gap-3 text-xs font-mono text-slate-400">
          <span>共收录 <strong>{pillarPosts.length}</strong> 篇深度思考</span>
          <span>·</span>
          <span>{info.tagline}</span>
        </div>
      </div>
    </div>

    <!-- Posts Grid -->
    {pillarPosts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {pillarPosts.map((post) => (
          <ArticleCard post={post} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 text-slate-500 bg-[#111827]/40 rounded-2xl border border-[#23304a] mb-16">
        该专区暂未收录文章。
      </div>
    )}

    <!-- Explore Other Pillars -->
    <div class="pt-8 border-t border-[#23304a]/70">
      <h2 class="text-sm font-semibold text-slate-400 mb-4">探索其它思想支柱</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {otherPillars.map((p) => (
          <a
            href={`/pillar/${p.id}`}
            class="flex items-center gap-3 p-4 rounded-xl bg-[#111827]/50 border border-[#23304a] hover:border-slate-600 hover:bg-[#162035] transition-all"
          >
            <span class="text-xl">{p.icon}</span>
            <div>
              <div class="text-sm font-bold text-slate-200">{p.name}</div>
              <div class="text-xs text-slate-500 line-clamp-1">{p.tagline}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
