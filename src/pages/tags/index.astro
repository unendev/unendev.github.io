---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const allPosts = await getCollection('blog');

// Aggregate tags with post references
const tagMap: Record<string, CollectionEntry<'blog'>[]> = {};
allPosts.forEach((post) => {
  const tags = post.data.tags || [];
  tags.forEach((tag) => {
    if (!tagMap[tag]) {
      tagMap[tag] = [];
    }
    tagMap[tag].push(post);
  });
});

const sortedTags = Object.keys(tagMap).sort((a, b) => tagMap[b].length - tagMap[a].length);
---

<BaseLayout title="标签索引" description="按标签分类浏览渥奇的思考卷轴">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <div class="mb-10 text-center">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-950/40 border border-sky-800/40 text-sky-400 text-xs font-mono mb-4">
        <span>🏷️</span>
        <span>全域知识索引</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-100 mb-3">
        文章标签索引
      </h1>
      <p class="text-sm text-slate-400">
        共梳理出 <strong>{sortedTags.length}</strong> 个知识与思辨标签
      </p>
    </div>

    <!-- Tag Cloud -->
    <div class="p-6 rounded-2xl bg-[#111827]/70 border border-[#23304a] mb-12 flex flex-wrap gap-2.5 justify-center">
      {sortedTags.map((tag) => {
        const count = tagMap[tag].length;
        return (
          <a
            href={`#${encodeURIComponent(tag)}`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono bg-slate-800/90 text-slate-300 hover:text-sky-300 hover:bg-slate-700/80 border border-slate-700/60 transition-colors"
          >
            <span>#{tag}</span>
            <span class="text-[10px] bg-slate-900/80 text-sky-400 px-1.5 py-0.5 rounded-full font-bold">
              {count}
            </span>
          </a>
        );
      })}
    </div>

    <!-- Tag Groups Stream -->
    <div class="space-y-10">
      {sortedTags.map((tag) => {
        const posts = tagMap[tag].sort(
          (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
        );
        return (
          <section
            id={encodeURIComponent(tag)}
            class="scroll-mt-24 p-6 rounded-2xl bg-[#111827]/40 border border-[#23304a]/80"
          >
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#23304a]">
              <h2 class="text-lg font-bold text-slate-100 flex items-center gap-2">
                <span class="text-sky-400">#</span>
                <span>{tag}</span>
              </h2>
              <span class="text-xs font-mono text-slate-500">
                收录 {posts.length} 篇
              </span>
            </div>

            <div class="divide-y divide-[#23304a]/60">
              {posts.map((post) => {
                const dateStr = post.data.pubDate instanceof Date
                  ? post.data.pubDate.toISOString().slice(0, 10)
                  : String(post.data.pubDate).slice(0, 10);
                return (
                  <div class="py-3 flex items-center justify-between gap-4 group">
                    <a
                      href={`/${post.data.legacySlug || post.slug}/`}
                      class="text-sm font-medium text-slate-300 group-hover:text-sky-400 transition-colors line-clamp-1"
                    >
                      {post.data.title}
                    </a>
                    <time datetime={dateStr} class="text-xs font-mono text-slate-500 flex-shrink-0">
                      {dateStr}
                    </time>
                  </div>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>
