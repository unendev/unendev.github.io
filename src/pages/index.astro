---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NoteCard from '../components/NoteCard.astro';
import { PILLARS, SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.getTime()-a.data.pubDate.getTime());
const essays = posts.filter(p => p.data.format === 'essay');
const notes = posts.filter(p => p.data.format === 'note');
---
<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-16">
    <section class="max-w-3xl mb-10 md:mb-12">
      <p class="text-sm text-sky-300 mb-4">渥奇的思考卷轴</p>
      <h1 class="text-2xl sm:text-4xl font-serif font-semibold text-slate-100 leading-relaxed mb-5 [text-wrap:balance]">让思考展开，也让片刻留下。</h1>
      <p class="text-base text-slate-400 leading-loose max-w-2xl">有些问题值得写成长文，有些感受只需几句话。这里记录工程与工具的实践，也留下阅读、音乐和虚构世界带来的追问。</p>
      <div class="flex flex-wrap gap-5 text-sm mt-6"><a class="text-sky-300 hover:underline" href="#essays">读长文 ↓</a><a class="text-slate-300 hover:text-sky-300" href="/notes/">看短札 →</a><a class="text-slate-300 hover:text-sky-300" href="/topics/">沿议题阅读 →</a></div>
    </section>
    <nav aria-label="主题分类" class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-12">
      {Object.values(PILLARS).map(p => <a href={`/pillar/${p.id}/`} class="rounded-xl border border-[#23304a] bg-[#111827]/60 px-4 py-4 hover:border-slate-500 transition-colors"><span class="block text-sm font-semibold text-slate-200 [text-wrap:balance]">{p.icon} {p.name}</span><span class="block text-xs text-slate-400 mt-2">{posts.filter(post => post.data.pillar === p.id).length} 篇记录</span></a>)}
    </nav>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-12 items-start">
      <aside class="lg:col-start-3 lg:row-start-1 min-w-0" aria-labelledby="notes-title">
        <div class="flex items-center justify-between mb-2"><h2 id="notes-title" class="text-xl font-serif font-semibold text-slate-100">最近短札</h2><a class="text-sm text-sky-300 hover:underline" href="/notes/">全部 →</a></div>
        <p class="text-sm text-slate-400 leading-relaxed mb-5">留下触动，也留下尚未回答的问题。</p>
        {notes.length ? notes.slice(0,3).map(post => <NoteCard post={post} compact />) : <p class="text-sm text-slate-400 py-6">这里留给下一次值得记录的瞬间。</p>}
      </aside>
      <section id="essays" class="lg:col-span-2 lg:col-start-1 lg:row-start-1 min-w-0 scroll-mt-24" aria-labelledby="essays-title">
        <div class="flex items-center justify-between mb-6"><h2 id="essays-title" class="text-xl font-serif font-semibold text-slate-100">长文</h2><span class="text-xs text-slate-400">{essays.length} 篇</span></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">{essays.map(post => <ArticleCard post={post} />)}</div>
      </section>
    </div>
  </div>
</BaseLayout>
